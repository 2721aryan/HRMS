# ─────────────────────────────────────────────────────────────────────────────
#  HRMS Environment Configuration
#  Copy this file to .env and fill in the values before running docker compose
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=hrms_user
DB_PASS=hrms_pass

# ── JWT Secret (REQUIRED) ─────────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -base64 64
# Or use: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# ── Email (optional — leave blank to disable email notifications) ─────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ── pgAdmin (only used with --profile tools) ──────────────────────────────────
PGADMIN_EMAIL=admin@hrms.local
PGADMIN_PASSWORD=admin

# ── Spring Profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
