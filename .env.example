# ─────────────────────────────────────────────────────────────────────────────
#  HRMS Environment Configuration
#  Copy this file to .env and fill in the values before running docker compose
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=hrms_user
DB_PASS=hrms_pass

# ── JWT Secret (REQUIRED) ─────────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -base64 64
# Or use: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# ── Email (optional — leave blank to disable email notifications) ─────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ── pgAdmin (only used with --profile tools) ──────────────────────────────────
PGADMIN_EMAIL=admin@hrms.local
PGADMIN_PASSWORD=admin

# ── Spring Profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── CORS & Cookies ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
APP_CORS_ORIGINS=http://localhost
# Set to true when serving over HTTPS (production with TLS)
APP_COOKIE_SECURE=false

# ── File Storage ─────────────────────────────────────────────────────────────────────
FILE_STORAGE_TYPE=local
# S3 settings (only used when FILE_STORAGE_TYPE=s3)
# S3_BUCKET=
# S3_REGION=ap-south-1
